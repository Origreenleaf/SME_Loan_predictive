}
med_iqr <- function(x, type) {
q <- quantile(x, c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE)
sprintf("%s (%s)", fmt_k(q[2], type), fmt_k(q[3] - q[1], type))
}
